{
  "name": "canva-image-toolkit-app",
  "version": "0.1.0",
  "private": true,
  "description": "Ferramentas locais para editar imagens selecionadas no Canva.",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "start": "npx @canva/cli apps start",
    "start:preview": "npx @canva/cli apps start --preview",
    "build": "npx @canva/cli apps build",
    "lint": "eslint .",
    "lint:types": "tsc",
    "lint:check": "npm run lint && npm run lint:types",
    "format": "prettier '**/*.{css,ts,tsx}' --write",
    "format:check": "prettier '**/*.{css,ts,tsx}' --check",
    "test": "jest --no-cache --detectOpenHandles",
    "postinstall": "tsx ./scripts/copy_env.ts"
  },
  "dependencies": {
    "@canva/app-hooks": "^0.0.0-beta.4",
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-ui-kit": "^5.14.2",
    "@canva/asset": "^2.3.0",
    "@canva/intents": "^2.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^7.1.11"
  },
  "devDependencies": {
    "@canva/app-eslint-plugin": "^1.0.0",
    "@canva/app-scripts": "^1.1.1",
    "@rspack/core": "2.0.8",
    "@swc/core": "1.15.1",
    "@swc/jest": "0.2.39",
    "@swc/plugin-formatjs": "8.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.17",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/webpack-env": "1.18.8",
    "eslint": "9.34.0",
    "jest": "30.2.0",
    "jest-css-modules-transform": "4.4.2",
    "jest-environment-jsdom": "30.2.0",
    "prettier": "3.6.2",
    "ts-jest": "29.4.1",
    "tsx": "4.22.4",
    "typescript": "5.9.2"
  },
  "overrides": {
    "@canva/app-scripts": {
      "@rspack/core": "$@rspack/core"
    }
  }
}
